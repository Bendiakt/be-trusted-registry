# ─────────────────────────────────────────────────────────────────────────────
# MyDD Backend — Staging Environment Variables
# Copier dans Railway → service mydd-backend-staging → Variables
#
# RÈGLES STAGING :
#   - Toujours utiliser des clés TEST (sk_test_, not sk_live_)
#   - Toujours utiliser une DATABASE_URL différente de prod
#   - JWT_SECRET différent de prod (rotation indépendante)
#   - FRONTEND_URL pointe sur staging.mydd.work
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=staging
PORT=8080

# ── Database (PostgreSQL staging — Railway auto-remplit après attach) ──────────
DATABASE_URL=postgresql://user:password@staging-host:5432/mydd_staging

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer des valeurs DIFFÉRENTES de prod :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=STAGING_CHANGE_ME_long_random_secret_64_chars_minimum
JWT_REFRESH_SECRET=STAGING_CHANGE_ME_different_long_random_secret

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=STAGING_CHANGE_ME_32_byte_hex_string

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=https://staging.mydd.work
CORS_ORIGINS=https://staging.mydd.work,http://localhost:5173

# ── Stripe TEST (JAMAIS sk_live_ en staging) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_test_CHANGE_ME

# ── Email (Resend — même compte, même domaine, flag staging dans le sujet) ─────
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM=MyDD Staging <noreply@mydd.work>

# ── Stockage (local pour staging — pas besoin de R2) ─────────────────────────
UPLOAD_DIR=./uploads

# ── Redis (optionnel — rate limiting) ─────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Sentry (projet staging séparé) ───────────────────────────────────────────
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/staging-project-id

# ── Rétention PII (plus courte en staging pour les tests) ────────────────────
RETENTION_API_KEY_USAGE_DAYS=7
RETENTION_AUDIT_LOG_DAYS=30

# ── Metrics ──────────────────────────────────────────────────────────────────
METRICS_TOKEN=STAGING_CHANGE_ME_metrics_token
