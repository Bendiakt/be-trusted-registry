# ─────────────────────────────────────────────────────────────────────────────
# MyDD Backend — Environment Variables
# Rename this file to .env and fill in the values before starting the server.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=5000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mydd_db

# Optional pool tuning (safe to omit — defaults are fine)
# PG_POOL_MIN=2
# PG_POOL_MAX=20
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000
# PG_STATEMENT_TIMEOUT_MS=15000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_long_random_secret_64_chars_minimum
JWT_REFRESH_SECRET=CHANGE_ME_different_long_random_secret

# ── Encryption (audit log integrity) ─────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_string

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173        # Comma-separated list for multi-domain

# ── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
# https://dashboard.stripe.com/webhooks  (use `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Email (Resend) ────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM=MyDD <noreply@mydd.io>        # Must be a verified domain in Resend

# ── File Storage ──────────────────────────────────────────────────────────────
# Option A — Local disk (default, good for dev)
UPLOAD_DIR=./uploads

# Option B — Cloudflare R2 (recommended for production)
# All four vars must be set to activate R2; otherwise falls back to local disk.
# R2_BUCKET_NAME=mydd-documents
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=CHANGE_ME
# R2_SECRET_ACCESS_KEY=CHANGE_ME
# R2_PUBLIC_URL=https://pub-HASH.r2.dev   # Only needed for public buckets

# ── Metrics guard ────────────────────────────────────────────────────────────
# Protects GET /metrics and GET /metrics/json (Prometheus + JSON dashboards).
# If set, requests must include: Authorization: Bearer <value>  OR  ?token=<value>
# If unset (local dev), the endpoints are open — set this in Railway for prod.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_TOKEN=CHANGE_ME_random_string

# ── Error Tracking (optional) ─────────────────────────────────────────────────
# Leave blank to disable. Run `npm install @sentry/node` first if enabling.
# SENTRY_DSN=https://...@sentry.io/...

# ── Performance knobs (optional — defaults shown, safe to omit) ───────────────
# SLOW_QUERY_WARN_MS=2000            # Log queries slower than this
# METRICS_QUERY_TIMEOUT_MS=5000      # Timeout for /api/metrics/business queries
# BUSINESS_CACHE_TTL_MS=300000       # How long to serve cached business metrics
# BUSINESS_CACHE_REFRESH_MS=60000    # Background refresh interval
# PG_POOL_MIN=2
# PG_POOL_MAX=20
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000
# PG_STATEMENT_TIMEOUT_MS=15000

# ── Testing ───────────────────────────────────────────────────────────────────
# Bypass email-verification gate so smoke tests can log in.
# !! NEVER set to true in production !!
# SMOKE_TEST_SKIP_EMAIL_VERIFY=true
